@model IEnumerable<Inventory>
@{
    ViewData["Title"] = "מלאי";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-clipboard-data"></i> ניהול מלאי</h3>
    <a href="/Inventory/Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> הוסף רשומת מלאי</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <div class="input-group">
                    <input type="text" name="search" class="form-control" placeholder="חפש לפי שם מוצר..." value="@ViewBag.Search" />
                    <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </div>
            @if (ViewBag.Search != null)
            {
                <div class="col-auto"><a href="/Inventory" class="btn btn-outline-secondary">נקה חיפוש</a></div>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>מוצר</th>
                    <th>כמות</th>
                    <th>כמות מינימלית</th>
                    <th>עדכון אחרון</th>
                    <th>מצב</th>
                    <th>פעולות</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.Quantity <= item.MinQuantity ? "table-warning" : "")">
                        <td>@item.InventoryId</td>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.MinQuantity</td>
                        <td>@item.LastUpdated?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (item.Quantity <= item.MinQuantity)
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> מלאי נמוך</span>
                            }
                            else
                            {
                                <span class="badge bg-success">תקין</span>
                            }
                        </td>
                        <td>
                            <a href="/Inventory/Edit/@item.InventoryId" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i></a>
                            <form method="post" action="/Inventory/Delete/@item.InventoryId" style="display:inline"
                                  onsubmit="return confirm('האם אתה בטוח שברצונך למחוק?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
