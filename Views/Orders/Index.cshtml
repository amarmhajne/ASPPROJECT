@model IEnumerable<Order>
@{
    ViewData["Title"] = "הזמנות";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-cart3"></i> ניהול הזמנות</h3>
    <a href="/Orders/Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> הוסף הזמנה חדשה</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <div class="input-group">
                    <input type="text" name="search" class="form-control" placeholder="חפש הזמנה..." value="@ViewBag.Search" />
                    <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </div>
            @if (ViewBag.Search != null)
            {
                <div class="col-auto"><a href="/Orders" class="btn btn-outline-secondary">נקה חיפוש</a></div>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>לקוח</th>
                    <th>עובד</th>
                    <th>תאריך</th>
                    <th>סטטוס</th>
                    <th>סכום כולל</th>
                    <th>הערות</th>
                    <th>פעולות</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var statusClass = item.Status switch
                    {
                        "Completed" => "bg-success",
                        "Processing" => "bg-info",
                        "Cancelled" => "bg-danger",
                        _ => "bg-warning text-dark"
                    };
                    var statusText = item.Status switch
                    {
                        "Pending" => "ממתין",
                        "Processing" => "בטיפול",
                        "Completed" => "הושלם",
                        "Cancelled" => "בוטל",
                        _ => item.Status
                    };
                    <tr>
                        <td>@item.OrderId</td>
                        <td>@item.CustomerName</td>
                        <td>@item.EmployeeName</td>
                        <td>@item.OrderDate?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge @statusClass">@statusText</span></td>
                        <td>@item.TotalAmount?.ToString("N2") ₪</td>
                        <td>@item.Notes</td>
                        <td>
                            <a href="/Orders/Edit/@item.OrderId" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i></a>
                            <form method="post" action="/Orders/Delete/@item.OrderId" style="display:inline"
                                  onsubmit="return confirm('האם אתה בטוח שברצונך לבטל הזמנה זו?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-danger btn-sm" title="ביטול הזמנה"><i class="bi bi-x-circle"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
