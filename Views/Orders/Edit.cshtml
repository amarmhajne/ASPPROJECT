@model Order
@{
    ViewData["Title"] = "עריכת הזמנה";
}

<h3 class="mb-4"><i class="bi bi-pencil-square"></i> עריכת הזמנה #@Model.OrderId</h3>

<div class="card">
    <div class="card-body">
        <form method="post" asp-action="Edit" asp-route-id="@Model.OrderId">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CustomerId" class="form-label">לקוח</label>
                    <select asp-for="CustomerId" asp-items="@(ViewBag.Customers as SelectList)" class="form-select">
                        <option value="">-- בחר לקוח --</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">עובד</label>
                    <select asp-for="EmployeeId" asp-items="@(ViewBag.Employees as SelectList)" class="form-select">
                        <option value="">-- בחר עובד --</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" asp-items="@(ViewBag.Statuses as SelectList)" class="form-select"></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TotalAmount" class="form-label"></label>
                    <input asp-for="TotalAmount" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-12 mb-3">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> שמור</button>
                <a href="/Orders" class="btn btn-secondary"><i class="bi bi-x-lg"></i> ביטול</a>
            </div>
        </form>
    </div>
</div>
