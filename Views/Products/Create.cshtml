@model Product
@{
    ViewData["Title"] = "הוספת מוצר";
}

<h3 class="mb-4"><i class="bi bi-plus-circle"></i> הוספת מוצר חדש</h3>

<div class="card">
    <div class="card-body">
        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ProductName" class="form-label"></label>
                    <input asp-for="ProductName" class="form-control" />
                    <span asp-validation-for="ProductName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SupplierId" class="form-label">ספק</label>
                    <select asp-for="SupplierId" asp-items="@(ViewBag.Suppliers as SelectList)" class="form-select">
                        <option value="">-- בחר ספק --</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Category" class="form-label"></label>
                    <input asp-for="Category" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="UnitPrice" class="form-label"></label>
                    <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="form-check mt-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> שמור</button>
                <a href="/Products" class="btn btn-secondary"><i class="bi bi-x-lg"></i> ביטול</a>
            </div>
        </form>
    </div>
</div>
