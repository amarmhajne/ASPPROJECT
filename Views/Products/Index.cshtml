@model IEnumerable<Product>
@{
    ViewData["Title"] = "מוצרים";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-box-seam"></i> ניהול מוצרים</h3>
    <a href="/Products/Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> הוסף מוצר חדש</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <div class="input-group">
                    <input type="text" name="search" class="form-control" placeholder="חפש מוצר..." value="@ViewBag.Search" />
                    <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </div>
            @if (ViewBag.Search != null)
            {
                <div class="col-auto"><a href="/Products" class="btn btn-outline-secondary">נקה חיפוש</a></div>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>שם מוצר</th>
                    <th>ספק</th>
                    <th>קטגוריה</th>
                    <th>מחיר יחידה</th>
                    <th>פעיל</th>
                    <th>פעולות</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductId</td>
                        <td>@item.ProductName</td>
                        <td>@item.SupplierName</td>
                        <td>@item.Category</td>
                        <td>@item.UnitPrice.ToString("N2") ₪</td>
                        <td>
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                @(item.IsActive ? "פעיל" : "לא פעיל")
                            </span>
                        </td>
                        <td>
                            <a href="/Products/Edit/@item.ProductId" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i></a>
                            <form method="post" action="/Products/Delete/@item.ProductId" style="display:inline"
                                  onsubmit="return confirm('האם אתה בטוח שברצונך למחוק?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
