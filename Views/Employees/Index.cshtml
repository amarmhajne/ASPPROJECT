@model IEnumerable<Employee>
@{
    ViewData["Title"] = "עובדים";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-people"></i> ניהול עובדים</h3>
    <a href="/Employees/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> הוסף עובד חדש
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <div class="input-group">
                    <input type="text" name="search" class="form-control" placeholder="חפש עובד..." value="@ViewBag.Search" />
                    <button class="btn btn-outline-primary" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
            @if (ViewBag.Search != null)
            {
                <div class="col-auto">
                    <a href="/Employees" class="btn btn-outline-secondary">נקה חיפוש</a>
                </div>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>שם פרטי</th>
                    <th>שם משפחה</th>
                    <th>שם משתמש</th>
                    <th>תפקיד</th>
                    <th>טלפון</th>
                    <th>אימייל</th>
                    <th>פעיל</th>
                    <th>פעולות</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EmployeeId</td>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>@item.Username</td>
                        <td>
                            <span class="badge @(item.Role == "Admin" ? "bg-danger" : "bg-info")">
                                @(item.Role == "Admin" ? "מנהל" : "מכירות")
                            </span>
                        </td>
                        <td>@item.Phone</td>
                        <td>@item.Email</td>
                        <td>
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                @(item.IsActive ? "פעיל" : "לא פעיל")
                            </span>
                        </td>
                        <td>
                            <a href="/Employees/Edit/@item.EmployeeId" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="/Employees/Delete/@item.EmployeeId" style="display:inline"
                                  onsubmit="return confirm('האם אתה בטוח שברצונך למחוק?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-danger btn-sm"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
